{
  "_limits": {
    "total": 15,
    "macos-15-intel": 5,
    "ubuntu-latest": 12,
    "windows-latest": 4
  },
  "ios": {
    "runs_on": "macos-15-intel",
    "test": "bash ../runner/scripts/test-ios.sh"
  },
  "mac": {
    "runs_on": "macos-15-intel",
    "test": "bash ../runner/scripts/test-mac.sh"
  },
  "android": {
    "runs_on": "ubuntu-latest",
    "test": "cd android && ./gradlew :app:assembleDebug :app:testDebugUnitTest --no-daemon"
  },
  "windows": {
    "runs_on": "windows-latest",
    "test": "if [ -f desktop/ci/test.sh ]; then bash desktop/ci/test.sh; else echo 'chưa có desktop/ci/test.sh (gói D00 tạo)'; fi"
  },
  "linux": {
    "runs_on": "ubuntu-latest",
    "test": "if [ -f desktop/ci/test.sh ]; then bash desktop/ci/test.sh; else echo 'chưa có desktop/ci/test.sh (gói D00 tạo)'; fi"
  },
  "factory-linux": {
    "runs_on": "ubuntu-latest",
    "test": "bash ci/test.sh"
  }
}
